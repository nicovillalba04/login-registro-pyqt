QPushButton#btn_login {
    background-color: #1548c8;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 11px 16px;
    font-weight: 600;
}
QPushButton#btn_login:hover    { background-color: #1240ad; }
QPushButton#btn_login:pressed  { background-color: #0e3590; }
QPushButton#btn_login:disabled { background-color: #9aa9bd; }

/* campos: borde suave, y marcado al escribir */
QLineEdit {
    background-color: white;
    color: #111a26;
    border: 1px solid #ccd4e0;
    border-radius: 8px;
    padding: 8px 10px;
}
QLineEdit:focus { border: 2px solid #1548c8; }

/* la tarjeta y el fondo */
QFrame#frame_tarjeta {
    background-color: #fbfcfd;
    border: 1px solid #ccd4e0;
    border-radius: 16px;
}
QStackedWidget { background-color: #e7eaef; }

/* texto legible también en modo oscuro */
QLabel, QCheckBox { color: #111a26; }

QLabel#label_mensaje[tipo="error"] {
    color: #b7361b;
    font-weight: 600;
}
QLabel#label_mensaje[tipo="exito"] {
    color: #0f7d55;
    font-weight: 600;
}